---
import { STR } from "../../../lib/i18n.js";
import { CATEGORY_SLUGS } from "../../../lib/category-meta.js";
import { hasEnPage, ogTopSet, pluginOgUrl } from "../../../lib/publish-policy.js";
import { readFileSync } from "node:fs";
import path from "node:path";
import { loadPlugins } from "../../../lib/plugins-data.js";
import BaseLayout from "../../../components/BaseLayout.astro";

export async function getStaticPaths() {
  // 构建时 cwd 恒为 site/；数据加载必须位于本函数内（Astro 编译约束）
  const browsePath = path.join(process.cwd(), "public", "data", "browse.json");
  let browse = [];
  try {
    browse = JSON.parse(readFileSync(browsePath, "utf8")).plugins || [];
  } catch (e) { /* 数据未生成时站点仍可构建（忽略） */ }
  // README 摘要：从 plugins 分片取 readme_text（内容增强，避免详情页过薄）
  const readmeMap = new Map();
  try {
    const { plugins } = loadPlugins();
    for (const x of plugins) if (x.readme_text) readmeMap.set(x.full_name, String(x.readme_text));
  } catch (e) { /* 无数据时详情页仅展示元信息 */ }
  // OG top-N 集合只算一次，经 props 传入每页（10k 页 × 每页重排 10k 的排序不可接受）
  const ogSet = ogTopSet(browse);

  // 仅收录含 "owner/repo" 形态的条目，避免生成畸形路径
  return browse
    .filter((p) => typeof p.full_name === "string" && p.full_name.includes("/") && !p.full_name.includes(".."))
    .map((p) => {
      const [owner, repo] = p.full_name.split("/");
      return { params: { owner, repo }, props: { plugin: p, all: browse, readmeText: readmeMap.get(p.full_name) || "", ogSet } };
    });
}

const { plugin: p, all, readmeText, ogSet } = Astro.props;
// --- i18n：zh 走根路径 /plugin/...（en 版本在 /en/plugin/...，两棵静态路由树；共享 BaseLayout） ---
const lang = "zh";
const s = STR[lang];
const langPrefix = "";
const site = Astro.site.origin; // astro.config 恒设 site（SITE_ORIGIN 单源）
const [owner, repo] = p.full_name.split("/");
const canonical = site + "/plugin/" + p.full_name + "/";
const zhUrl = site + "/plugin/" + p.full_name + "/";
// 英文页按 star 门槛生成（publish-policy）：不足阈值时无 en 版本——hreflang 不指向 404，
// 语言切换降级到 /en/ 首页（英文用户仍可浏览英文目录）。
const enPage = hasEnPage(p);
const enUrl = enPage ? site + "/en/plugin/" + p.full_name + "/" : null;
const catLabel = (p.categories && p.categories.length)
  ? (s.languages[p.categories[0]] || p.categories[0])
  : null;
const pageTitle = catLabel
  ? `${p.full_name} — ${catLabel} DSH 插件`
  : `${p.full_name} — DSH 插件`;
let pageDescription = p.description
  ? p.description
  : `DeepSeek Harness（DSH）插件 ${p.full_name}：${catLabel ? catLabel + " 分类，" : ""}GitHub ★ ${p.stars}，主要语言 ${p.language || "未知"}。`;
pageDescription = pageDescription.replace(/\s+/g, " ").slice(0, 155).trim();
const ogImage = pluginOgUrl(site, p, ogSet); // top-N 之外回退站点级 /og.png
const updated = p.pushed_at ? p.pushed_at.slice(0, 10) : null;

const related = all
  .filter((x) => x.full_name !== p.full_name && (x.categories || []).some((c) => (p.categories || []).includes(c)))
  .sort((a, b) => b.stars - a.stars)
  .slice(0, 3);

// README 摘要：去掉代码块/markdown 符号，压缩空白，截断 1200 字符
function readmeExcerpt(md) {
  if (!md) return "";
  let t = String(md)
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/<[^>]*>/g, " ")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/[#*_>`~|]{1,}/g, " ")
    .replace(/-{3,}/g, " ")
    .replace(/\s+/g, " ")
    .trim();
  if (t.length < 80) return "";
  return t.length > 1200 ? t.slice(0, 1200) + "…" : t;
}
const excerpt = readmeExcerpt(readmeText);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": p.full_name,
      "alternateName": repo,
      "description": pageDescription,
      "url": canonical,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Any",
      "inLanguage": "zh",
      "dateModified": p.pushed_at || undefined,
      "author": {
        "@type": "Organization",
        "name": owner,
        "url": `https://github.com/${owner}`
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": s.siteName, "item": site + "/" },
        { "@type": "ListItem", "position": 2, "name": p.full_name, "item": canonical }
      ]
    }
  ]
};
---
<BaseLayout
  lang={lang}
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  canonical={canonical}
  zhUrl={zhUrl}
  enUrl={enUrl}
  ogImage={ogImage}
  ogImageAlt={p.full_name}
  jsonLd={jsonLd}
  langToggleHref={enPage ? `/en/plugin/${owner}/${repo}/` : "/en/"}
  containerClass="max-w-4xl"
>
  <nav class="mt-5 text-xs text-muted" aria-label="面包屑">
    <ol class="flex items-center gap-1.5">
      <li><a href="/" class="hover:text-accent">{s.siteName}</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/" class="hover:text-accent">{s.all}</a></li>
      <li aria-hidden="true">/</li>
      <li class="truncate text-ink" aria-current="page">{p.full_name}</li>
    </ol>
  </nav>

  <main id="main-content" class="mt-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0">
        <h1 class="font-mono text-xl font-semibold break-all">{p.full_name}</h1>
        <p class="mt-1 text-sm text-muted">
          <a href={`https://github.com/${owner}`} class="hover:text-accent" rel="noopener">{owner}</a>
          <span aria-hidden="true"> · </span>★ {Number(p.stars).toLocaleString()}
          {p.language && <span><span aria-hidden="true"> · </span>{p.language}</span>}
          {updated && <span><span aria-hidden="true"> · </span>{s.lastSync}: {updated}</span>}
        </p>
      </div>
      <a href={p.html_url} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-lg bg-accent/15 px-4 py-2 text-sm font-medium text-accent hover:bg-accent/25">
        {s.openGitHub}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </a>
    </div>

    <p class="mt-5 text-[15px] leading-relaxed text-ink">{p.description || "—"}</p>

    {excerpt && (
      <section class="mt-8">
        <h2 class="text-sm font-semibold text-ink">README 摘要</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">{excerpt}</p>
        <a href={p.html_url} target="_blank" rel="noopener" class="mt-3 inline-block text-xs text-accent hover:underline">在 GitHub 查看完整 README →</a>
      </section>
    )}

    <div class="mt-5 flex flex-wrap gap-1.5 text-[11px]">
      {(p.categories || []).map((c) => CATEGORY_SLUGS[c]
        ? <a href={`/category/${CATEGORY_SLUGS[c]}/`} class="rounded-full bg-accent/10 px-2.5 py-1 text-accent hover:bg-accent/20">{s.languages[c] || c}</a>
        : <span class="rounded-full bg-accent/10 px-2.5 py-1 text-accent">{s.languages[c] || c}</span>)}
      {(p.tags || []).slice(0, 8).map((t) => <span class="rounded-full border border-line px-2.5 py-1 text-muted">{t}</span>)}
    </div>

    {related.length > 0 && (
      <section class="mt-10">
        <h2 class="text-sm font-semibold text-ink">{s.category}</h2>
        <div class="mt-3 grid gap-3 sm:grid-cols-3">
          {related.map((x) => (
            <a href={`/plugin/${x.full_name}/`} class="block rounded-xl border border-line bg-surface p-4 transition hover:border-accent/60 hover:bg-surface2">
              <span class="font-mono text-[13px] font-medium break-all">{x.full_name}</span>
              <p class="line-clamp-2 mt-2 text-xs text-muted">{x.description || "—"}</p>
              <p class="mt-2 text-xs text-muted">★ {Number(x.stars).toLocaleString()}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</BaseLayout>
