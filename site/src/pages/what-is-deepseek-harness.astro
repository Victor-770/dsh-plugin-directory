---
import BaseLayout from "../components/BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import RelatedPlugins from "../components/RelatedPlugins.astro";
import { STR } from "../lib/i18n.js";
import { getArticle, extractHeadings, buildArticleJsonLd } from "../lib/articles-data.js";

const article = getArticle("what-is-deepseek-harness", "en");
const lang = "en";
const s = STR[lang];
const site = Astro.site.origin;
const canonical = site + "/what-is-deepseek-harness";
const zhUrl = site + "/articles/what-is-deepseek-harness/";
const enUrl = site + "/en/articles/what-is-deepseek-harness/";
const ogImage = site + "/og.png";

const headings = extractHeadings(article.contentHtml);
const jsonLd = buildArticleJsonLd({ article, siteOrigin: site, canonical, lang });
---
<BaseLayout
  lang={lang}
  pageTitle={`${article.pageTitle || article.title} — ${s.siteName}`}
  pageDescription={article.pageDescription}
  canonical={canonical}
  zhUrl={zhUrl}
  enUrl={enUrl}
  ogImage={ogImage}
  langToggleHref="/articles/what-is-deepseek-harness/"
  jsonLd={jsonLd}
  containerClass="max-w-5xl"
>
  <nav class="mt-6 text-xs text-muted" aria-label="Breadcrumbs">
    <ol class="flex items-center gap-1.5 flex-wrap">
      <li><a href="/en/" class="hover:text-accent">{s.siteName}</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/en/articles/" class="hover:text-accent">{s.articles}</a></li>
      <li aria-hidden="true">/</li>
      <li class="truncate text-ink max-w-[200px] sm:max-w-md" aria-current="page">{article.title}</li>
    </ol>
  </nav>

  <article class="mt-8">
    <!-- Article Header -->
    <header class="border-b border-line pb-8">
      <div class="flex flex-wrap items-center gap-2 text-xs text-muted">
        <span class="rounded-md bg-accent/15 px-2.5 py-1 font-semibold text-accent">{article.category}</span>
        <span aria-hidden="true">·</span>
        <span>{s.publishedOn} <time datetime={article.publishedAt}>{article.publishedAt}</time></span>
        {article.updatedAt && article.updatedAt !== article.publishedAt && (
          <span>(Updated {article.updatedAt})</span>
        )}
        <span aria-hidden="true">·</span>
        <span>{article.readingTime}</span>
      </div>

      <h1 class="mt-4 text-2xl font-bold tracking-tight text-ink sm:text-3xl lg:text-4xl leading-tight">
        {article.title}
      </h1>

      <p class="mt-3 text-sm text-muted">
        {s.authorBy} <span class="font-medium text-ink">{article.author}</span>
      </p>

      {article.snippet && (
        <div class="mt-6 rounded-xl border border-accent/30 bg-accent/5 p-4 text-sm leading-relaxed text-ink/90 sm:p-5">
          <div class="font-semibold text-accent text-xs uppercase tracking-wider mb-1.5">Quick Takeaway / Snippet</div>
          <p>{article.snippet}</p>
        </div>
      )}
    </header>

    <!-- Main Layout: Content + Desktop Sidebar TOC -->
    <div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-[1fr_240px]">
      <main id="main-content" class="min-w-0">
        <!-- Content -->
        <div class="prose max-w-none" set:html={article.contentHtml} />

        <!-- FAQ Section -->
        {article.faq && article.faq.length > 0 && (
          <FaqAccordion faq={article.faq} lang={lang} />
        )}

        <!-- Featured Plugins Mentioned Section -->
        {article.relatedPluginSlugs && article.relatedPluginSlugs.length > 0 && (
          <RelatedPlugins pluginSlugs={article.relatedPluginSlugs} lang={lang} />
        )}

        <!-- Sources Section -->
        {article.sources && article.sources.length > 0 && (
          <section class="mt-12 pt-8 border-t border-line" aria-labelledby="sources-heading">
            <h2 id="sources-heading" class="text-lg font-semibold text-ink">{s.sourcesTitle}</h2>
            <ul class="mt-4 space-y-2 text-xs text-muted">
              {article.sources.map((src) => (
                <li>
                  <strong class="text-ink">{src.publisher}</strong> — <em>{src.title}</em> — <a href={src.url} class="text-accent underline break-all" target="_blank" rel="noopener noreferrer nofollow">{src.url}</a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </main>

      <!-- Sticky Table of Contents -->
      <aside class="hidden lg:block">
        <div class="sticky top-20">
          <TableOfContents headings={headings} lang={lang} />
        </div>
      </aside>
    </div>
  </article>

  <p slot="footer">© {new Date().getFullYear()} DSH Plugin Directory · <a class="underline" href="/en/" rel="noopener">{s.siteName}</a> · <a class="underline" href="/en/articles/" rel="noopener">{s.articles}</a> · <a class="underline" href="/en/about/" rel="noopener">{s.about}</a> · <a class="underline" href="https://github.com/Kristin130/dsh-plugin-directory/blob/main/LICENSE" rel="noopener">AGPL-3.0</a></p>
</BaseLayout>
