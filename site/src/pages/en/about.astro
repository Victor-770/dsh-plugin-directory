---
import { STR } from "../../lib/i18n.js";
import { readFileSync } from "node:fs";
import path from "node:path";
import BaseLayout from "../../components/BaseLayout.astro";

const browsePath = path.join(process.cwd(), "public", "data", "browse.json");
let pluginCount = 0;
let generatedAt = null;
try {
  const raw = JSON.parse(readFileSync(browsePath, "utf8"));
  pluginCount = raw.plugins?.length || 0;
  generatedAt = raw.generatedAt || null;
} catch { /* 数据未生成时站点仍可构建 */ }

const lang = "en";
const s = STR[lang];
const site = Astro.site.origin; // astro.config 恒设 site（SITE_ORIGIN 单源）
const canonical = site + "/en/about/";
const pageTitle = "About DSH Plugin Directory — DeepSeek Harness Plugin Directory";
const pageDescription = "DSH Plugin Directory: a plugin index for DeepSeek Harness users. Syncs the GitHub dsh-plugin topic every 6 hours, with bilingual CN/EN full-text search and category browsing.";
const ogImage = site + "/og.png";
---
<BaseLayout
  lang={lang}
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  canonical={canonical}
  zhUrl={site + "/about/"}
  enUrl={site + "/en/about/"}
  ogImage={ogImage}
  langToggleHref="/about/"
  containerClass="max-w-3xl"
>
  <main id="main-content" class="mt-8">
    <nav class="text-xs text-muted" aria-label="Breadcrumb">
      <ol class="flex items-center gap-1.5">
        <li><a href="/en/" class="hover:text-accent">{s.siteName}</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-ink" aria-current="page">About</li>
      </ol>
    </nav>

    <h1 class="mt-5 text-2xl font-semibold">About DSH Plugin Directory</h1>

    <section class="mt-6 space-y-4 text-[15px] leading-relaxed text-ink">
      <p>
        <strong>DSH Plugin Directory</strong> is a plugin index for <a class="underline text-accent" href="https://github.com/deepseek-ai/deepseek-harness" rel="noopener">DeepSeek Harness</a> (DSH) users.
        It organizes open-source repositories under the GitHub <code class="rounded bg-surface2 px-1.5 py-0.5 text-[13px]">dsh-plugin</code> topic into a
        browsable, bilingual full-text-searchable catalog, so you can quickly find plugins for skins, terminal tools, agent skills, search, media processing and more.
      </p>
      <p>
        Data comes from public GitHub repositories and is synced automatically every 6 hours — currently <strong>{pluginCount} repositories</strong>
        {generatedAt ? " (last synced " + generatedAt.slice(0, 10) + ")" : ""}.
        Each plugin's description, stars, language, last-update time and README excerpt come from the repository itself; content is shown in the authors' original language and is not translated by this site.
      </p>
      <p>
        Plugins are grouped into 7 functional categories (Skins / UI, Terminal / TUI, Tools / Dev, Search, Agents, Media / Content, Fun / Ads),
        assigned by rules with manual fallback for high-star repositories. Search supports CN/EN alias matching (e.g. "皮肤" ↔ "skin").
      </p>
      <p class="text-muted text-sm">
        This site does <b>not</b> verify plugin compatibility and does <b>not</b> endorse any plugin; listing is not a recommendation.
        Before installing third-party plugins, review their README, license and code yourself.
      </p>
    </section>

    <section class="mt-8 rounded-xl border border-line bg-surface p-5">
      <h2 class="text-sm font-semibold text-ink">Project &amp; feedback</h2>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li>· Open-source: source code and the data pipeline live at <a class="underline text-accent" href="https://github.com/Kristin130/dsh-plugin-directory" rel="noopener">github.com/Kristin130/dsh-plugin-directory</a></li>
        <li>· Data source: <a class="underline text-accent" href="https://github.com/topics/dsh-plugin" rel="noopener">GitHub topic: dsh-plugin</a></li>
        <li>· Issues with listings, categorization or search? Open an <a class="underline text-accent" href="https://github.com/Kristin130/dsh-plugin-directory/issues" rel="noopener">Issue</a> on the project repo</li>
        <li>· Licensed under <a class="underline text-accent" href="https://github.com/Kristin130/dsh-plugin-directory/blob/main/LICENSE" rel="noopener">GNU AGPL-3.0</a>: free to use, modify and redistribute, but network services built on it must publish their modifications</li>
      </ul>
    </section>
  </main>

  <p slot="footer">© {new Date().getFullYear()} DSH Plugin Directory · <a class="underline" href="/en/" rel="noopener">{s.siteName}</a> · <a class="underline" href="/en/articles/" rel="noopener">{s.articles}</a> · <a class="underline" href="/en/about/" rel="noopener">About</a> · <a class="underline" href="https://github.com/Kristin130/dsh-plugin-directory/blob/main/LICENSE" rel="noopener">AGPL-3.0</a></p>
</BaseLayout>
