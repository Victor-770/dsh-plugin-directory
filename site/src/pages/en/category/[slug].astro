---
import { STR, CATEGORY_ORDER } from "../../../lib/i18n.js";
import { CATEGORY_SLUGS, CATEGORY_DESC } from "../../../lib/category-meta.js";
import { readFileSync } from "node:fs";
import path from "node:path";
import "../../../styles/global.css";

export async function getStaticPaths() {
  // 构建时 cwd 恒为 site/；数据加载必须位于本函数内（Astro 编译约束）
  const browsePath = path.join(process.cwd(), "public", "data", "browse.json");
  let browse = [];
  try {
    browse = JSON.parse(readFileSync(browsePath, "utf8")).plugins || [];
  } catch (e) { /* 数据未生成时站点仍可构建（忽略） */ }
  const paths = [];
  for (const key of CATEGORY_ORDER) {
    const plugins = browse
      .filter((p) => (p.categories || []).includes(key))
      .sort((a, b) => b.stars - a.stars);
    // 空分类不生成页面，避免 thin content
    if (!plugins.length) continue;
    paths.push({ params: { slug: CATEGORY_SLUGS[key] }, props: { slug: CATEGORY_SLUGS[key], catKey: key, plugins } });
  }
  return paths;
}

const { slug, catKey, plugins } = Astro.props;
// --- i18n：zh 走根路径 /category/...（en 版本在 /en/category/...） ---
const lang = "en";
const s = STR[lang];
const langPrefix = "/en";
const site = (Astro.site?.origin) || "https://dsh-plugin-directory.online";
const catName = lang === "zh" ? catKey : (s.languages[catKey] || catKey);
const canonical = site + langPrefix + "/category/" + slug + "/";
const zhUrl = site + "/category/" + slug + "/";
const enUrl = site + "/en/category/" + slug + "/";
const pageTitle = lang === "zh" ? `${catName} 插件（${plugins.length} 个）— DSH 插件目录` : `${catName} Plugins (${plugins.length}) — DSH Plugin Directory`;
const pageDescription = (CATEGORY_DESC[lang][slug] || "") + (lang === "zh"
  ? ` 本站共收录 ${plugins.length} 个相关插件，按热度排序，点击直达 GitHub 仓库。`
  : ` Listing ${plugins.length} plugins sorted by stars, with one-click access to their GitHub repos.`);
const ogImage = site + "/og.png";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": s.siteName, "item": site + langPrefix + "/" },
        { "@type": "ListItem", "position": 2, "name": `${catName} 插件`, "item": canonical }
      ]
    }
  ]
};
---
<!doctype html>
<html lang={lang} class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="content-language" content="en" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="zh" href={zhUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="x-default" href={zhUrl} />
  <meta name="theme-color" content="#0b0e14" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={s.siteName} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={pageTitle} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <script is:inline>
    (function () {
      var saved = null; try { saved = localStorage.getItem("dsh-theme"); } catch (e) {}
      var dark = saved ? saved === "dark" : window.matchMedia("(prefers-color-scheme: light)").matches ? false : true;
      document.documentElement.classList.toggle("dark", dark);
      document.documentElement.classList.toggle("light", !dark);
    })();
  </script>
</head>
<body class="min-h-screen">
  <a class="skip-link" href="#main-content" data-i18n="skipToContent">{s.skipToContent}</a>
  <div class="mx-auto max-w-5xl px-4 pb-16">
    <header class="sticky top-0 z-20 border-b border-line bg-bg/90 backdrop-blur">
      <div class="flex items-center justify-between gap-3 py-3">
        <a href={langPrefix + "/"} class="flex items-center gap-2" aria-label={s.siteName}>
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-accent/15 text-accent font-bold" aria-hidden="true">D</span>
          <span class="font-semibold tracking-tight">{s.siteName}</span>
        </a>
        <div class="flex items-center gap-2">
          <a id="lang-toggle" href={lang === "en" ? "/" : "/en/"} class="shrink-0 rounded-lg border border-line bg-surface px-3 py-2 text-xs font-medium hover:border-accent" hreflang={lang === "en" ? "zh" : "en"}>{s.langName}</a>
          <button id="theme-toggle" class="shrink-0 rounded-lg border border-line bg-surface px-3 py-2 text-xs" title={s.theme} aria-label={s.theme}>
            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          </button>
        </div>
      </div>
    </header>

    <nav class="mt-5 text-xs text-muted" aria-label={lang === "zh" ? "面包屑" : "Breadcrumb"}>
      <ol class="flex items-center gap-1.5">
        <li><a href={langPrefix + "/"} class="hover:text-accent">{s.siteName}</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={langPrefix + "/"} class="hover:text-accent">{s.category}</a></li>
        <li aria-hidden="true">/</li>
        <li class="truncate text-ink" aria-current="page">{catName}</li>
      </ol>
    </nav>

    <main id="main-content" class="mt-6">
      <h1 class="text-xl font-semibold">{catName} {lang === "zh" ? "插件" : "Plugins"} <span class="text-sm font-normal text-muted">({plugins.length})</span></h1>
      <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-muted">{pageDescription}</p>

      <div class="mt-6 flex flex-wrap gap-1.5 text-[11px]">
        {CATEGORY_ORDER.filter((k) => k !== catKey).map((k) => (
          <a href={langPrefix + "/category/" + CATEGORY_SLUGS[k] + "/"} class="rounded-full border border-line px-2.5 py-1 text-muted hover:border-accent hover:text-accent">{s.languages[k]}</a>
        ))}
      </div>

      <ul class="mt-6 divide-y divide-line rounded-xl border border-line bg-surface">
        {plugins.map((p) => (
          <li>
            <a href={`${langPrefix}/plugin/${p.full_name}/`} class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-4 py-3 transition hover:bg-surface2">
              <span class="font-mono text-[13px] font-medium break-all">{p.full_name}</span>
              <span class="shrink-0 text-xs text-muted">
                ★ {Number(p.stars).toLocaleString()}
                {p.language && <span class="ml-2">{p.language}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </main>

    <footer class="mt-12 border-t border-line pt-4 text-xs text-muted">
      <p>DSH Plugin Directory · <a class="underline" href={langPrefix + "/"} rel="noopener">{s.siteName}</a> · GitHub topic <a class="underline" href="https://github.com/topics/dsh-plugin" rel="noopener">dsh-plugin</a></p>
    </footer>
  </div>
  <script is:inline>
    document.getElementById("theme-toggle").addEventListener("click", () => {
      const dark = document.documentElement.classList.toggle("dark");
      document.documentElement.classList.toggle("light", !dark);
      try { localStorage.setItem("dsh-theme", dark ? "dark" : "light"); } catch (e) {}
    });
  </script>
</body>
</html>