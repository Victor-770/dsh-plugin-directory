---
// 站点共享布局：head/meta/OG/主题初始化/顶栏（logo + 语言/主题切换）/页脚，唯一一份实现。
// 中英文页面只传 lang 与各自的语言参数——消灭成对复制与 en 页面永不执行的 zh 死分支。
// 页面特有内容经默认插槽注入；顶栏中部（如首页搜索框）经 name="header-middle" 插槽注入；
// 页脚差异经 name="footer" 插槽覆盖（缺省渲染标准页脚）。
import { STR } from "../lib/i18n.js";
import "../styles/global.css";

const {
  lang = "zh",
  pageTitle,
  pageDescription,
  canonical,
  zhUrl,
  enUrl,
  ogImage,
  ogImageAlt,
  jsonLd,
  langToggleHref,
  containerClass = "max-w-5xl",
  h1SiteName = false, // 首页顶栏站点名用 h1，其余页面用 span
} = Astro.props;
const s = STR[lang];
const langPrefix = lang === "en" ? "/en" : "";
const site = Astro.site.origin; // astro.config 恒设 site（SITE_ORIGIN 单源）
---
<!doctype html>
<html lang={lang} class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="content-language" content={lang} />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="zh" href={zhUrl} />
  {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
  <link rel="alternate" hreflang="x-default" href={zhUrl} />
  <meta name="theme-color" content="#0b0e14" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={s.siteName} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt || pageTitle} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={ogImage} />
    <!-- favicon 声明：按 Google Search 指南成对声明——ico(sizes=any) 兜底 + 48x48 PNG 主图标
         （方形、48px 的倍数）。?v=1 为 favicon 缓存击穿：浏览器对"无图标"的负缓存极其顽固
         且不吃普通刷新（站点早期无图标时期访问过的浏览器一直显示默认地球）；换版本号强制
         全网重新拉取，图标变更时同步 bump。favicon.svg 留作 JSON-LD logo。 -->
    <link rel="icon" href="/favicon.ico?v=1" sizes="any" />
    <link rel="icon" href="/favicon-48x48.png?v=1" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=1" />
    <link rel="manifest" href="/site.webmanifest" />
  <slot name="head-extra" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
  <script is:inline>
    // 主题：默认深色，跟随系统，可手动切换（localStorage 持久）
    (function () {
      var saved = null; try { saved = localStorage.getItem("dsh-theme"); } catch (e) {}
      var dark = saved ? saved === "dark" : window.matchMedia("(prefers-color-scheme: light)").matches ? false : true;
      document.documentElement.classList.toggle("dark", dark);
      document.documentElement.classList.toggle("light", !dark);
    })();
  </script>
</head>
<body class="min-h-screen">
  <a class="skip-link" href="#main-content" data-i18n="skipToContent">{s.skipToContent}</a>
  <div class={`mx-auto ${containerClass} px-4 pb-16`}>
    <header class="sticky top-0 z-20 border-b border-line bg-bg/90 backdrop-blur">
      <div class="flex items-center justify-between gap-3 py-3">
        <a href={langPrefix + "/"} class="flex items-center gap-2 shrink-0" aria-label={s.siteName}>
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-accent/15 text-accent font-bold" aria-hidden="true">D</span>
          {h1SiteName
            ? <h1 class="font-semibold tracking-tight" data-i18n="siteName">{s.siteName}</h1>
            : <span class="font-semibold tracking-tight" data-i18n="siteName">{s.siteName}</span>}
        </a>
        <div class="flex items-center gap-2">
          <slot name="header-middle" />
          <a href={langPrefix + "/articles/"} class="shrink-0 rounded-lg px-2.5 py-1.5 text-xs font-medium text-muted hover:text-ink hover:bg-surface2 transition">{s.articles}</a>
          <a href={langPrefix + "/about/"} class="shrink-0 rounded-lg px-2.5 py-1.5 text-xs font-medium text-muted hover:text-ink hover:bg-surface2 transition">{s.about}</a>
          <a id="lang-toggle" href={langToggleHref} class="shrink-0 rounded-lg border border-line bg-surface px-3 py-2 text-xs font-medium hover:border-accent" data-i18n="langName" hreflang={lang === "en" ? "zh" : "en"}>{s.langName}</a>
          <button id="theme-toggle" class="shrink-0 rounded-lg border border-line bg-surface px-3 py-2 text-xs" title={s.theme} aria-label={s.theme}>
            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          </button>
        </div>
      </div>
    </header>

    <slot />

    <footer class="mt-12 border-t border-line pt-4 text-xs text-muted">
      <slot name="footer">
        <p>© {new Date().getFullYear()} DSH Plugin Directory · <a class="underline" href={langPrefix + "/"} rel="noopener">{s.siteName}</a> · <a class="underline" href={langPrefix + "/articles/"} rel="noopener">{s.articles}</a> · <a class="underline" href={langPrefix + "/about/"} rel="noopener">{s.about}</a> · GitHub topic <a class="underline" href="https://github.com/topics/dsh-plugin" rel="noopener">dsh-plugin</a> · <a class="underline" href="https://github.com/Kristin130/dsh-plugin-directory/blob/main/LICENSE" rel="noopener">AGPL-3.0</a></p>
      </slot>
    </footer>
  </div>
  <script is:inline>
    document.getElementById("theme-toggle").addEventListener("click", () => {
      const dark = document.documentElement.classList.toggle("dark");
      document.documentElement.classList.toggle("light", !dark);
      try { localStorage.setItem("dsh-theme", dark ? "dark" : "light"); } catch (e) {}
    });
  </script>
</body>
</html>
